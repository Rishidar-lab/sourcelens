# --- Python / backend ---
backend/.venv/
backend/**/__pycache__/
**/__pycache__/
*.pyc
backend/.pytest_cache/
.pytest_cache/
*.egg-info/

# --- Data / vector store / uploads (never commit user content or embeddings) ---
backend/data/
backend/data/tmp/
backend/data/chroma/
*.sqlite3
*.sqlite

# --- Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
npm-debug.log*

# --- QA pack extraction / benchmark run artifacts ---
# Keep summarized JSON results (referenced from docs/EVALUATION.md); never
# commit the throwaway per-run Chroma vector stores they're built from.
qa/runs/_chroma_*/
qa/runs/_data_*/
qa/runs/_pi_chroma_*/
qa/runs/_pi_data_*/

# --- OS / editor ---
.DS_Store
*.swp
