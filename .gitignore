# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# --- QA pack extraction / benchmark run artifacts ---
qa/runs/*.json
!qa/runs/.gitkeep

# --- OS / editor ---
.DS_Store
*.swp
